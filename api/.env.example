# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto donde escucha la API
PORT=3000

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# La base "cowregister" la crea Prisma sola en la primera migración.
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/cowregister?schema=public"
