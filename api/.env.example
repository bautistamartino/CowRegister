# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto donde escucha la API
PORT=3000

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# La base "cowregister" la crea Prisma sola en la primera migración.
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/cowregister?schema=public"

# Contraseña del administrador de la plataforma. NO la guardes acá: se usa una sola vez, puesta en
# la misma línea del comando que crea al administrador (así no queda en ningún archivo):
#   PowerShell: $env:ADMIN_PASSWORD="..."; npm run admin:crear -w api -- --nombre "Nombre" --email correo@ejemplo.com
#   Git Bash:   ADMIN_PASSWORD="..." npm run admin:crear -w api -- --nombre "Nombre" --email correo@ejemplo.com
# Si no la ponés, el comando la pide por consola sin mostrarla.
# ADMIN_PASSWORD=
