// Esquema de la base de datos de CowRegister.
// Cada cambio acá se aplica con una migración: npx prisma migrate dev --name <descripcion>
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────

enum Rol {
  DUENO
  ENCARGADO
  VETERINARIO
}

enum Sexo {
  HEMBRA
  MACHO
}

// Estado del animal. Cada establecimiento define con ReglaLote
// a qué lote va un animal según su estado.
enum EstadoAnimal {
  RECIEN_NACIDO
  VAQUILLONA
  EN_ORDENE
  SECA
  BAJA // vendido o muerto: sale de los lotes pero conserva su historial
}

// Por qué un animal está dado de baja. Lista cerrada: la Etapa 3 (ventas y muertes)
// agrega sus valores con ALTER TYPE ... ADD VALUE. Las bajas anteriores no lo tienen.
enum MotivoBaja {
  PARTO_ANULADO // cría dada de baja porque se anuló el parto en el que nació (spec 004)
  VENTA // baja registrada por el usuario (spec 006, migración bajas_enums)
  MUERTE // idem
}

// ─── Modelos ────────────────────────────────────────────────────────
// Todos usan UUID como id (se pueden generar sin conexión, Etapa 6)
// y guardan cuándo se crearon y modificaron.

model Establecimiento {
  id            String   @id @default(uuid(7)) @db.Uuid
  nombre        String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarios     Usuario[]
  lotes        Lote[]
  reglasLote   ReglaLote[]
  animales     Animal[]
  semenToros   SemenToro[]
  eventos      Evento[]
  producciones Produccion[]

  @@map("establecimientos")
}

model Usuario {
  id                String   @id @default(uuid(7)) @db.Uuid
  establecimientoId String   @db.Uuid
  nombre            String
  email             String   @unique
  passwordHash      String // nunca se guarda la contraseña, solo su hash (argon2)
  rol               Rol
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  establecimiento         Establecimiento @relation(fields: [establecimientoId], references: [id])
  sesiones                Sesion[]
  eventosRegistrados      Evento[]        @relation("EventoRegistradoPor")
  eventosAnulados         Evento[]        @relation("EventoAnuladoPor")
  produccionesRegistradas Produccion[]    @relation("ProduccionRegistradaPor")
  produccionesAnuladas    Produccion[]    @relation("ProduccionAnuladaPor")

  // Destino de las claves foráneas compuestas de Evento (registradoPor y anuladoPor):
  // quien registró o anuló un evento tiene que ser del mismo tambo.
  @@unique([establecimientoId, id])
  @@index([establecimientoId])
  @@map("usuarios")
}

// Sesión iniciada en un dispositivo. La cookie del navegador lleva un
// token aleatorio; acá se guarda solo su hash SHA-256, así un robo de la
// base no permite usar las sesiones. Borrar la fila cierra la sesión.
model Sesion {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @db.Uuid
  tokenHash String   @unique
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

model Lote {
  id                String   @id @default(uuid(7)) @db.Uuid
  establecimientoId String   @db.Uuid
  nombre            String
  descripcion       String?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  animales        Animal[]
  reglas          ReglaLote[]

  // Destino de la clave foránea compuesta de ReglaLote: así una regla solo
  // puede apuntar a un lote de su mismo tambo.
  @@unique([establecimientoId, id])
  // El nombre es único por tambo SIN distinguir mayúsculas: lo garantiza el
  // índice "lotes_nombre_unico_sin_mayusculas" sobre lower(nombre), creado a
  // mano en la migración lotes_restricciones (Prisma no expresa índices sobre
  // funciones). Por eso acá no hay @@unique de nombre.
  @@map("lotes")
}

// "Las vacas en estado X van al lote Y", configurable por cada tambo.
model ReglaLote {
  id                String       @id @default(uuid(7)) @db.Uuid
  establecimientoId String       @db.Uuid
  estado            EstadoAnimal
  loteId            String       @db.Uuid
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  // Clave foránea compuesta (establecimientoId, loteId): el lote destino tiene
  // que ser del mismo tambo que la regla. Restrict impide borrar un lote que
  // es destino de algún estado.
  lote            Lote            @relation(fields: [establecimientoId, loteId], references: [establecimientoId, id], onDelete: Restrict)

  // Una sola regla por estado en cada tambo. El estado BAJA nunca tiene regla:
  // lo garantiza el CHECK "reglas_lote_sin_baja" (agregado a mano en la migración).
  @@unique([establecimientoId, estado])
  @@map("reglas_lote")
}

model Animal {
  id                String       @id @default(uuid(7)) @db.Uuid
  establecimientoId String       @db.Uuid
  // Número de caravana = número del botón RFID. Es texto porque puede
  // tener ceros a la izquierda o letras. Único entre los animales
  // activos del tambo (índice parcial creado en la migración con SQL).
  numero            String
  sexo              Sexo
  estado            EstadoAnimal
  fechaNacimiento   DateTime?    @db.Date
  madreId           String?      @db.Uuid
  loteId            String?      @db.Uuid
  fechaBaja         DateTime?    @db.Date
  motivoBaja        MotivoBaja? // solo en una baja (CHECK animales_motivo_baja_coherente)
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  // Claves foráneas compuestas: el lote y la madre tienen que ser del mismo tambo.
  // Con loteId / madreId nulos no se controlan (un animal sin lote o sin madre es válido).
  // Restrict: no se borra un lote con animales ni se borra una madre con crías.
  lote            Lote?           @relation(fields: [establecimientoId, loteId], references: [establecimientoId, id], onDelete: Restrict)
  madre           Animal?         @relation("MadreCrias", fields: [establecimientoId, madreId], references: [establecimientoId, id], onDelete: Restrict)
  crias           Animal[]        @relation("MadreCrias")
  eventos         Evento[]
  // Parto del que nació (si es una cría dada de alta desde un parto, spec 004).
  criaDeParto     CriaParto?
  // Cambios hechos a mano (spec 005).
  cambios         CambioAnimal[]
  // Litros de leche cargados (spec 008).
  producciones    Produccion[]

  // Destino de la clave foránea compuesta de la madre (igual que en Lote).
  @@unique([establecimientoId, id])
  // Destino de la clave de crias_parto: la cría viva tiene que ser del tambo y de la madre del parto.
  @@unique([establecimientoId, id, madreId])
  // Además, a mano en la migración animales_restricciones: CHECK de número
  // normalizado (animales_numero_normalizado) y de madre distinta (animales_madre_distinta);
  // y en la migración partos_secados: animal de baja sin lote (animales_baja_sin_lote) y
  // motivo de baja solo en una baja (animales_motivo_baja_coherente); y en la migración
  // bajas_base (spec 006): toda baja nueva con fecha y motivo (animales_baja_con_fecha_y_motivo,
  // NOT VALID) y un activo sin fecha de baja (animales_activo_sin_baja).
  @@index([establecimientoId, numero]) // búsqueda rápida por número
  @@index([loteId])
  @@map("animales")
}

// ─── Reproducción (spec 003) ────────────────────────────────────────

// Tipo de evento. La spec 004 agregó PARTO y SECADO (migración partos_tipos_evento).
enum TipoEvento {
  SERVICIO
  TACTO
  PARTO
  SECADO
  BAJA // baja por venta o muerte (spec 006, migración bajas_enums)
}

enum TipoServicio {
  INSEMINACION
  MONTA_NATURAL
}

enum ResultadoTacto {
  PRENADA
  VACIA
}

// Catálogo de semen y toros de cada tambo. No se borra: se desactiva.
model SemenToro {
  id                String   @id @default(uuid(7)) @db.Uuid
  establecimientoId String   @db.Uuid
  nombre            String
  raza              String? // null = "sin raza"
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  servicios       Servicio[]

  // Destino de la clave foránea compuesta de Servicio.
  @@unique([establecimientoId, id])
  // A mano en la migración reproduccion_base: índice único sobre lower(nombre) por
  // tambo (semen_toros_nombre_unico_sin_mayusculas) y CHECK de nombre y raza.
  @@map("semen_toros")
}

// Evento reproductivo de un animal. Tabla común: el detalle de cada tipo vive en
// su propia tabla (Servicio, Tacto; la 004 suma Parto y Secado). Los eventos solo
// se agregan: nunca se editan ni se borran; si se cargó mal, se anula.
model Evento {
  id                String     @id @default(uuid(7)) @db.Uuid
  establecimientoId String     @db.Uuid
  animalId          String     @db.Uuid
  tipo              TipoEvento
  fecha             DateTime   @db.Date
  registradoPorId   String     @db.Uuid
  // Momento de registro: además de ser la fecha de creación, desempata el orden
  // entre eventos de la misma fecha. La API lo hace estrictamente creciente por animal.
  creadoEn          DateTime   @default(now())
  // Anulación: las tres columnas van juntas (CHECK eventos_anulacion_completa).
  anuladoEn         DateTime?
  anuladoPorId      String?    @db.Uuid
  motivoAnulacion   String?

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  animal          Animal          @relation(fields: [establecimientoId, animalId], references: [establecimientoId, id], onDelete: Restrict)
  registradoPor   Usuario         @relation("EventoRegistradoPor", fields: [establecimientoId, registradoPorId], references: [establecimientoId, id], onDelete: Restrict)
  anuladoPor      Usuario?        @relation("EventoAnuladoPor", fields: [establecimientoId, anuladoPorId], references: [establecimientoId, id], onDelete: Restrict)
  servicio        Servicio?
  tacto           Tacto?
  parto           Parto?          @relation("PartoDelEvento")
  secado          Secado?
  baja            Baja?
  // Partos que usaron este evento (un servicio) como genética de la cría.
  partosGenetica  Parto[]         @relation("ServicioDeGenetica")

  // Destino de las claves compuestas de los detalles (con el tipo, para que un
  // servicio solo pueda colgar de un evento de tipo SERVICIO).
  @@unique([establecimientoId, id, tipo])
  // Destino de las claves del parto: exigen el tipo Y la vaca del evento (spec 004).
  @@unique([establecimientoId, id, tipo, animalId])
  // Nunca dos eventos de un animal con el mismo momento de registro.
  @@unique([animalId, creadoEn])
  @@index([animalId, fecha, creadoEn]) // lectura en orden total
  // Informes del tambo (spec 007): leen los eventos de todo el tambo por tipo y fecha.
  @@index([establecimientoId, tipo, fecha])
  @@map("eventos")
}

model Servicio {
  eventoId          String       @id @db.Uuid
  establecimientoId String       @db.Uuid
  tipo              TipoEvento   @default(SERVICIO) // CHECK: siempre SERVICIO
  tipoServicio      TipoServicio
  semenId           String?      @db.Uuid

  evento Evento     @relation(fields: [establecimientoId, eventoId, tipo], references: [establecimientoId, id, tipo], onDelete: Restrict)
  // Con semenId nulo ("No especificado") no se controla la clave foránea.
  semen  SemenToro? @relation(fields: [establecimientoId, semenId], references: [establecimientoId, id], onDelete: Restrict)

  @@unique([establecimientoId, eventoId, tipo])
  @@index([semenId])
  @@map("servicios")
}

model Tacto {
  eventoId              String         @id @db.Uuid
  establecimientoId     String         @db.Uuid
  tipo                  TipoEvento     @default(TACTO) // CHECK: siempre TACTO
  resultado             ResultadoTacto
  fechaProbableIndicada DateTime?      @db.Date // la que escribió el usuario (solo si PRENADA)
  anomalias             String?

  evento Evento @relation(fields: [establecimientoId, eventoId, tipo], references: [establecimientoId, id, tipo], onDelete: Restrict)

  @@unique([establecimientoId, eventoId, tipo])
  @@map("tactos")
}

// ─── Partos, crías y secados (spec 004) ─────────────────────────────

// Detalle de un evento PARTO. Guarda el estado y el lote que tenía la vaca antes de
// parir, para devolverla a ese estado si se anula el parto.
model Parto {
  eventoId          String       @id @db.Uuid
  establecimientoId String       @db.Uuid
  tipo              TipoEvento   @default(PARTO) // CHECK partos_tipo: siempre PARTO
  madreId           String       @db.Uuid // siempre la vaca del evento (lo exige la clave a Evento)
  estadoAnterior    EstadoAnimal // CHECK: vaquillona, en ordeñe o seca
  // Lote previo: "sin lote" (false, null), "lote previo" (true, id) o "lote previo
  // eliminado" (true, null). Sin @relation: la clave foránea partos_loteAnterior_fkey
  // está escrita a mano con ON DELETE SET NULL ("loteAnteriorId"), que Prisma no modela.
  tuvoLoteAnterior  Boolean      @default(false)
  loteAnteriorId    String?      @db.Uuid
  // Genética: servicio vinculado (ambos nulos si no hay). servicioTipo existe solo para
  // que la clave compuesta exija que sea un evento de tipo SERVICIO.
  servicioId        String?      @db.Uuid
  servicioTipo      TipoEvento?

  evento   Evento      @relation("PartoDelEvento", fields: [establecimientoId, eventoId, tipo, madreId], references: [establecimientoId, id, tipo, animalId], onDelete: Restrict)
  // Con servicioId nulo no se controla la clave (un parto sin genética es válido).
  servicio Evento?     @relation("ServicioDeGenetica", fields: [establecimientoId, servicioId, servicioTipo, madreId], references: [establecimientoId, id, tipo, animalId], onDelete: Restrict)
  crias    CriaParto[]

  // Destino de la clave de la relación con Evento (uno a uno).
  @@unique([establecimientoId, eventoId, tipo, madreId])
  // Destino de la clave de crias_parto: la cría es de la madre de ESTE parto.
  @@unique([establecimientoId, eventoId, madreId])
  @@index([loteAnteriorId])
  @@index([servicioId])
  @@map("partos")
}

// Detalle de un evento SECADO. Igual que el parto, recuerda estado y lote previos.
model Secado {
  eventoId          String       @id @db.Uuid
  establecimientoId String       @db.Uuid
  tipo              TipoEvento   @default(SECADO) // CHECK secados_tipo: siempre SECADO
  estadoAnterior    EstadoAnimal // CHECK: siempre EN_ORDENE
  tuvoLoteAnterior  Boolean      @default(false)
  loteAnteriorId    String?      @db.Uuid // FK a mano secados_loteAnterior_fkey (ver Parto)

  evento Evento @relation(fields: [establecimientoId, eventoId, tipo], references: [establecimientoId, id, tipo], onDelete: Restrict)

  @@unique([establecimientoId, eventoId, tipo])
  @@index([loteAnteriorId])
  @@map("secados")
}

// Detalle de un evento BAJA (spec 006): la venta o muerte de un animal. Recuerda estado y lote
// previos (como Parto y Secado) para poder revertirla. El animal guarda además una copia de la
// fecha y el motivo (animales.fechaBaja y motivoBaja); manda la baja registrada y un disparador
// diferido de la base (bajas_coherencia) impide que difieran.
// A mano en la migración bajas_base (Prisma no lo modela): CHECK bajas_tipo, bajas_motivo,
// bajas_observaciones_largo, bajas_estado_anterior y bajas_lote_anterior_coherente; clave
// bajas_loteAnterior_fkey con ON DELETE SET NULL ("loteAnteriorId"); índice único parcial
// bajas_una_vigente_por_animal (a lo sumo una baja vigente por animal) e índice parcial del
// listado; disparadores de coherencia y de solo-agregar.
model Baja {
  eventoId          String       @id @db.Uuid
  establecimientoId String       @db.Uuid
  tipo              TipoEvento   @default(BAJA) // CHECK bajas_tipo: siempre BAJA
  animalId          String       @db.Uuid // siempre el animal del evento (lo exige la clave a Evento)
  motivo            MotivoBaja // CHECK bajas_motivo: solo VENTA o MUERTE
  observaciones     String? // null = sin observaciones (CHECK de largo 1 a 200)
  estadoAnterior    EstadoAnimal // CHECK: distinto de BAJA
  tuvoLoteAnterior  Boolean      @default(false)
  loteAnteriorId    String?      @db.Uuid // FK a mano bajas_loteAnterior_fkey (ver Parto)
  // true al crearla; pasa a false al revertir (equivale a eventos.anuladoEn IS NULL).
  vigente           Boolean      @default(true)

  evento Evento @relation(fields: [establecimientoId, eventoId, tipo, animalId], references: [establecimientoId, id, tipo, animalId], onDelete: Restrict)

  @@unique([establecimientoId, eventoId, tipo, animalId])
  @@index([loteAnteriorId])
  @@map("bajas")
}

// Cada cría de un parto, viva o nacida muerta. La viva apunta al animal dado de alta.
model CriaParto {
  id                String   @id @default(uuid(7)) @db.Uuid
  establecimientoId String   @db.Uuid
  eventoId          String   @db.Uuid // el parto
  madreId           String   @db.Uuid
  orden             Int // 1 o 2 (CHECK crias_orden)
  sexo              Sexo
  nacidaMuerta      Boolean  @default(false)
  observaciones     String? // null = sin observaciones (CHECK de largo)
  animalId          String?  @db.Uuid // nulo si nació muerta (CHECK crias_viva_o_muerta)
  creadoEn          DateTime @default(now())

  parto  Parto   @relation(fields: [establecimientoId, eventoId, madreId], references: [establecimientoId, eventoId, madreId], onDelete: Restrict)
  // Con animalId nulo (nació muerta) no se controla la clave.
  animal Animal? @relation(fields: [establecimientoId, animalId, madreId], references: [establecimientoId, id, madreId], onDelete: Restrict)

  @@unique([eventoId, orden])
  // Una cría viva pertenece a UN solo parto.
  @@unique([animalId])
  // Destino de la relación uno a uno desde Animal.
  @@unique([establecimientoId, animalId, madreId])
  @@map("crias_parto")
}

// ─── Editar animal y mover de lote a mano (spec 005) ────────────────

// Campo modificado a mano. El orden de las opciones es el orden fijo en que se muestran
// los cambios de un mismo guardado (RF-15): número, sexo, fecha de nacimiento, madre, lote.
enum CampoCambio {
  NUMERO
  SEXO
  FECHA_NACIMIENTO
  MADRE
  LOTE
}

// Historial de cambios manuales: una fila por dato modificado. Solo se agrega (un trigger
// en la base impide UPDATE y DELETE). Guarda TEXTO copiado del momento (nombre del lote,
// número de la madre, nombre del usuario) y NO tiene claves foráneas a lote, madre ni
// usuario, para que se puedan eliminar sin tocar el historial (decisión 7 de la spec).
// Solo se relaciona con su animal, y con clave compuesta: es del tambo de su animal.
// A mano en la migración editar_animal: trigger de solo agregar y los CHECK
// cambios_valores_distintos y cambios_usuario_nombre.
model CambioAnimal {
  id                String      @id @default(uuid(7)) @db.Uuid
  establecimientoId String      @db.Uuid
  animalId          String      @db.Uuid
  campo             CampoCambio
  valorAnterior     String? // null = "sin dato" o "sin lote"
  valorNuevo        String?
  usuarioId         String      @db.Uuid // sin clave foránea (decisión 7)
  usuarioNombre     String // copia del nombre al momento del cambio
  creadoEn          DateTime    @default(now()) // igual para todos los registros de un guardado

  animal Animal @relation(fields: [establecimientoId, animalId], references: [establecimientoId, id], onDelete: Restrict)

  @@index([animalId, creadoEn])
  @@map("cambios_animal")
}

// ─── Producción: litros por vaca (spec 008) ─────────────────────────

// Turno de ordeñe. El orden del enum hace que ORDER BY turno DESC ponga la tarde antes que la mañana.
enum TurnoOrdeno {
  MANANA
  TARDE
}

// Litros de UNA vaca en UN ordeñe (fecha + turno). Solo se agrega: se anula con motivo, nunca se
// edita ni se borra. Los litros se guardan como entero en décimas (litros x 10): las sumas y
// comparaciones son exactas, sin errores de coma flotante.
// El lote es una COPIA (loteId sin clave foránea + loteNombre): si se renombra o elimina el lote,
// el registro conserva el que tenía la vaca al cargar (igual que CambioAnimal, spec 005).
// A mano en la migración produccion_base (Prisma no lo modela): índice único parcial
// producciones_un_vigente_por_ordeno (una carga vigente por vaca, fecha y turno), CHECK de litros,
// fecha, anulación, motivo y lote, y el disparador producciones_solo_agregar.
model Produccion {
  id                String      @id @default(uuid(7)) @db.Uuid
  establecimientoId String      @db.Uuid
  animalId          String      @db.Uuid
  fecha             DateTime    @db.Date
  turno             TurnoOrdeno
  litrosDecimas     Int // litros x 10, de 0 a 999 (CHECK producciones_litros_rango)
  loteId            String?     @db.Uuid // sin clave foránea: nulo = "Sin lote"
  loteNombre        String? // nombre copiado: nulo = "Sin lote"
  registradoPorId   String      @db.Uuid
  creadoEn          DateTime    @default(now())
  // Hora en que se cargó en la tablet (spec 009): solo informativa, nunca ordena ni valida. Nula si no vino.
  cargadoEnDispositivo DateTime?
  actualizadoEn     DateTime    @updatedAt
  // Anulación: las tres columnas van juntas (CHECK producciones_anulacion_completa).
  anuladoEn         DateTime?
  anuladoPorId      String?     @db.Uuid
  motivoAnulacion   String?

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  animal          Animal          @relation(fields: [establecimientoId, animalId], references: [establecimientoId, id], onDelete: Restrict)
  registradoPor   Usuario         @relation("ProduccionRegistradaPor", fields: [establecimientoId, registradoPorId], references: [establecimientoId, id], onDelete: Restrict)
  anuladoPor      Usuario?        @relation("ProduccionAnuladaPor", fields: [establecimientoId, anuladoPorId], references: [establecimientoId, id], onDelete: Restrict)

  @@index([establecimientoId, fecha]) // informe de leche
  @@index([animalId, fecha, turno]) // ficha de la vaca
  @@map("producciones")
}
